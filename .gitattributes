# Normalize line endings to LF on commit, checkout as-is
* text=auto eol=lf

# Explicitly LF for these types
*.py    text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
*.toml  text eol=lf
*.txt   text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.sh    text eol=lf

# Binary — no line ending conversion
*.png   binary
*.bmp   binary
*.jpg   binary
*.wav   binary
*.mp3   binary
*.flac  binary
*.pdf   binary
*.pyc   binary
